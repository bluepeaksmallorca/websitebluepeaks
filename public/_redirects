# Cloudflare Pages redirects.
# https://developers.cloudflare.com/pages/configuration/redirects/
#
# WordPress → Astro migration map.
#
# Every URL that currently ranks or has links pointing at it must land
# somewhere sensible, or the move to Cloudflare costs the search equity the
# old site built up. 301 (permanent) is what passes that equity on.
#
# >>> BEFORE GOING LIVE <<<
# Export the full list of live URLs from the WordPress site — Google Search
# Console › Pages, or a crawl with Screaming Frog — and add a line here for
# every one not reproduced at the same path. The entries below cover what we
# could confirm from the current site; they are a starting point, not a
# complete map.

# --- Pages that are not being carried over --------------------------------

# /medical/ has no equivalent in the new page set. Point it at whichever page
# should inherit it — the homepage for now.
/medical            /                       301
/medical/*          /                       301

# --- WordPress plumbing ---------------------------------------------------

/feed               /blog/                  301
/feed/*             /blog/                  301
/comments/feed      /blog/                  301
/wp-content/*       /                       301
/wp-includes/*      /                       301
/wp-json/*          /                       301
/xmlrpc.php         /                       301

# Date-based post archives, if the blog used them.
/20:year/:month/:slug   /blog/:slug/        301

/category/*         /blog/                  301
/tag/*              /blog/                  301
/author/*           /                       301

# --- Language paths --------------------------------------------------------
# If WordPress served English under an /en/ prefix, English is now at the root.
# Uncomment if that applies.
# /en/*             /:splat                 301

# --- Tidy-ups --------------------------------------------------------------
/index.html         /                       301
/home               /                       301
