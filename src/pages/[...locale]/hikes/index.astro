---
import type { GetStaticPaths } from 'astro';

import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import HikeCard from '../../../components/HikeCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import AnswerBox from '../../../components/AnswerBox.astro';

import type { Locale } from '../../../data/site';
import { hikesIndex } from '../../../data/pages/listings';
import { localeStaticPaths } from '../../../lib/paths';
import { getLocalisedEntries, parseId, byDifficulty } from '../../../lib/content';
import { useTranslations, absoluteUrl, localePath } from '../../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, trail } from '../../../lib/schema';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const copy = hikesIndex[locale];

// Easiest first: it is the order people actually shop in.
const hikes = (await getLocalisedEntries('hikes', locale)).sort(byDifficulty);

const routeKey = 'hikes';
const url = absoluteUrl(localePath(locale, routeKey));

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: copy.metaTitle,
    description: copy.metaDescription,
    locale,
    type: 'CollectionPage',
    updated: new Date(),
  }),
  breadcrumbNode(url, trail(locale, [{ name: t('nav.hikes'), path: 'hikes' }])),
  {
    '@type': 'ItemList',
    '@id': `${url}#list`,
    name: copy.heading,
    numberOfItems: hikes.length,
    itemListElement: hikes.map((hike, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: hike.data.title,
      url: absoluteUrl(localePath(locale, `hikes/${parseId(hike.id).slug}`)),
    })),
  },
]);
---

<Base
  title={copy.metaTitle}
  description={copy.metaDescription}
  locale={locale}
  routeKey={routeKey}
  jsonLd={jsonLd}
>
  <PageHeader eyebrow={copy.eyebrow} title={copy.heading} lede={copy.lede} />

  <section class="section">
    <div class="wrap">
      <div class="hikes-intro">
        <AnswerBox>
          <p>{copy.intro}</p>
        </AnswerBox>
      </div>

      <div class="grid" style="--min: 18rem">
        {
          hikes.map((hike, index) => (
            <HikeCard
              locale={locale}
              slug={parseId(hike.id).slug}
              title={hike.data.title}
              summary={hike.data.summary}
              image={hike.data.heroImage}
              imageAlt={hike.data.heroAlt}
              facts={hike.data.facts}
              index={index}
            />
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta locale={locale} />
</Base>

<style>
  .hikes-intro {
    max-width: var(--width-prose);
    margin-bottom: var(--space-xl);
  }
</style>
