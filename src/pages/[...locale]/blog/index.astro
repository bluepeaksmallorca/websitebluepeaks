---
import type { GetStaticPaths } from 'astro';

import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import PostCard from '../../../components/PostCard.astro';

import type { Locale } from '../../../data/site';
import { blogIndex } from '../../../data/pages/listings';
import { localeStaticPaths } from '../../../lib/paths';
import { getLocalisedEntries, parseId, byDateDesc } from '../../../lib/content';
import { useTranslations, absoluteUrl, localePath, formatDate } from '../../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, trail } from '../../../lib/schema';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const copy = blogIndex[locale];

const posts = (await getLocalisedEntries('blog', locale)).sort(byDateDesc);

const routeKey = 'blog';
const url = absoluteUrl(localePath(locale, routeKey));

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: copy.metaTitle,
    description: copy.metaDescription,
    locale,
    type: 'CollectionPage',
    updated: new Date(),
  }),
  breadcrumbNode(url, trail(locale, [{ name: t('nav.blog'), path: 'blog' }])),
  {
    '@type': 'Blog',
    '@id': `${url}#blog`,
    name: copy.heading,
    description: copy.metaDescription,
    inLanguage: locale,
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: absoluteUrl(localePath(locale, `blog/${parseId(post.id).slug}`)),
      datePublished: post.data.published.toISOString(),
    })),
  },
]);
---

<Base
  title={copy.metaTitle}
  description={copy.metaDescription}
  locale={locale}
  routeKey={routeKey}
  jsonLd={jsonLd}
>
  <PageHeader eyebrow={copy.eyebrow} title={copy.heading} lede={copy.lede} />

  <section class="section">
    <div class="wrap">
      <p class="blog-intro">{copy.intro}</p>

      {
        posts.length === 0 ? (
          <p class="muted">Nothing published yet.</p>
        ) : (
          <div class="grid" style="--min: 19rem">
            {posts.map((post) => (
              <PostCard
                locale={locale}
                slug={parseId(post.id).slug}
                title={post.data.title}
                summary={post.data.summary}
                published={post.data.published}
                author={post.data.author}
                level={2}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner locale={locale} />
</Base>

<style>
  .blog-intro {
    max-width: var(--measure);
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--space-xl);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

</style>
