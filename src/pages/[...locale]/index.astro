---
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import VideoHero from '../../components/VideoHero.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Faq from '../../components/Faq.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PostCard from '../../components/PostCard.astro';

import { site, guides, type Locale } from '../../data/site';
import { homeCopy, homeLocales, partners } from '../../data/pages/home';
import { localeStaticPaths } from '../../lib/paths';
import { getLocalisedEntries, parseId, byDateDesc } from '../../lib/content';
import { localePath, useTranslations, absoluteUrl, formatDate } from '../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, faqNode, trail } from '../../lib/schema';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const { copy, isFallback } = homeCopy(locale);

const posts = (await getLocalisedEntries('blog', locale)).sort(byDateDesc).slice(0, 3);

const url = absoluteUrl(localePath(locale));

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: copy.metaTitle,
    description: copy.metaDescription,
    locale,
    updated: new Date(),
  }),
  breadcrumbNode(url, trail(locale, [])),
  // Answers below are drafts; the markup still emits so the shape is right
  // from day one. Review the text in src/data/pages/home.ts before launch.
  faqNode(url, copy.faqs),
]);

const services = [
  { title: copy.privateTitle, body: copy.privateBody, path: 'private-hikes', tone: 'black' },
  { title: copy.businessTitle, body: copy.businessBody, path: 'custom-hikes', tone: 'teal' },
  { title: copy.otherTitle, body: copy.otherBody, path: 'hikes', tone: 'teal' },
] as const;
---

<Base
  title={copy.metaTitle}
  description={copy.metaDescription}
  locale={locale}
  routeKey=""
  availableLocales={homeLocales}
  isFallback={isFallback}
  jsonLd={jsonLd}
  overHero
>
  {/*
    No `video` prop yet, so the hero renders its poster frame. Drop the file in
    as public/video/hero.mp4 (plus hero.webm and a real hero-poster.jpg) and
    add video="/video/hero" here — nothing else changes.
  */}
  <VideoHero
    poster="/video/hero-poster.jpg"
    label={copy.heroVideoLabel}
    scrollHint={copy.scrollHint}
  />

  {/* ---------------------------------------------------------- strapline */}
  <section class="section section--tight">
    <div class="wrap wrap--prose text-center">
      {isFallback && <div class="home__notice"><TranslationNotice locale={locale} /></div>}

      <h2 class="home__strapline">{copy.strapline}</h2>

      <p class="voice home__intro">
        {copy.intro.before}<strong>{copy.intro.emphasis}</strong>{copy.intro.after}
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------- photo grid */}
  <section class="section section--tight home__photos">
    <div class="wrap">
      <PhotoGrid
        photos={[
          { alt: 'Helena, mountain guide at Blue Peaks Mallorca', seed: 'helena' },
          { alt: 'A cove on the north coast of Mallorca', seed: 'coast' },
          { alt: 'Wild goats above the sea in the Serra de Tramuntana', seed: 'goats' },
          { alt: 'Matija, mountain guide at Blue Peaks Mallorca', seed: 'matija' },
        ]}
      />
    </div>
  </section>

  {/* ------------------------------------------------------------ welcome */}
  <section class="section section--tight" aria-labelledby="welcome-heading">
    <div class="wrap wrap--prose text-center">
      <h2 class="visually-hidden" id="welcome-heading">
        About {guides.map((g) => g.name).join(' and ')}
      </h2>

      <p class="voice">{copy.welcome}</p>

      <div class="languages">
        <h3 class="languages__label">{copy.languagesLabel}</h3>
        <ul class="languages__list">
          {
            site.languagesSpoken.map((language) => (
              <li>
                <span class="languages__dot" aria-hidden="true" />
                {language}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- services */}
  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-title">
        <h2 class="section-title__text" id="services-heading">{copy.servicesTitle}</h2>
      </div>

      <div class="services">
        {
          services.map((service) => (
            <article class="service">
              <a
                href={localePath(locale, service.path)}
                class:list={['service__bar', `service__bar--${service.tone}`]}
              >
                {service.title}
              </a>
              <p class="service__body">{service.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- mantra */}
  <section class="section section--tight">
    <div class="wrap text-center">
      <div class="section-title">
        <h2 class="section-title__text">{copy.mantra}</h2>
      </div>
      <p class="home__mantra-sub">{copy.mantraSub}</p>
    </div>
  </section>

  {/* ---------------------------------------------------------- CTA banner */}
  <CtaBanner locale={locale} title={copy.ctaTitle} buttonLabel={copy.ctaButton} />

  {/* --------------------------------------------------------------- blog */}
  {
    posts.length > 0 && (
      <section class="section section--white" aria-labelledby="blog-heading">
        <div class="wrap">
          <div class="section-title">
            <h2 class="section-title__text" id="blog-heading">
              {copy.blogTitle}
            </h2>
          </div>

          <div class="grid" style="--min: 19rem">
            {posts.map((post) => (
              <PostCard
                locale={locale}
                slug={parseId(post.id).slug}
                title={post.data.title}
                summary={post.data.summary}
                published={post.data.published}
              />
            ))}
          </div>

          <p class="home__blog-all">
            <a class="btn btn--outline" href={localePath(locale, 'blog')}>
              {copy.blogAll}
            </a>
          </p>
        </div>
      </section>
    )
  }

  {/* --------------------------------------------------------------- FAQs */}
  <section class="section section--white">
    <div class="wrap">
      <Faq locale={locale} faqs={copy.faqs} heading={copy.faqTitle} />
    </div>
  </section>

  {/* ----------------------------------------------------------- partners */}
  <section class="section section--tight" aria-labelledby="partners-heading">
    <div class="wrap">
      <div class="section-title">
        <h2 class="section-title__text" id="partners-heading">{copy.partnersTitle}</h2>
      </div>

      <ul class="partners">
        {
          partners.map((partner) => (
            <li class="partners__item">
              {partner.url ? (
                <a href={partner.url} rel="noopener" target="_blank">
                  {partner.name}
                </a>
              ) : (
                <span>{partner.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .home__notice {
    margin-bottom: var(--space-l);
    text-align: left;
  }

  .home__strapline {
    font-size: var(--step-4);
    font-weight: 600;
    color: var(--heading-olive);
    max-width: 18ch;
    margin-inline: auto;
  }

  .home__intro {
    margin-top: var(--space-xl);
    max-width: 30ch;
    margin-inline: auto;
  }

  .home__photos {
    padding-top: 0;
  }

  /* ---- Languages row ---- */

  .languages {
    margin-top: var(--space-2xl);
  }

  .languages__label {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--charcoal);
    margin-bottom: var(--space-m);
  }

  .languages__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .languages__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: var(--space-m);
    font-size: var(--step-1);
  }

  /* Hairline separators between languages, matching the live site. */
  .languages__list li + li {
    border-left: 1px solid var(--border-strong);
  }

  .languages__dot {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: inset 0 0 0 3px var(--greige);
  }

  /* ---- Services ---- */

  .services {
    display: grid;
    gap: var(--space-xl);
    max-width: 44rem;
    margin-inline: auto;
  }

  .service__bar {
    display: block;
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius-s);
    font-size: var(--step-2);
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition:
      transform var(--duration) var(--ease-out),
      filter var(--duration) var(--ease-out);
  }

  .service__bar--black {
    background: var(--black);
    color: #fff;
  }

  .service__bar--teal {
    background: var(--teal);
    color: #fff;
  }

  .service__bar:hover {
    filter: brightness(1.12);
    color: #fff;
  }

  .service__bar:active {
    transform: translateY(1px);
  }

  .service__body {
    margin-top: var(--space-m);
    text-align: center;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: 46ch;
    margin-inline: auto;
  }

  .home__mantra-sub {
    font-weight: 600;
    color: var(--charcoal);
  }

  .home__blog-all {
    margin-top: var(--space-xl);
    text-align: center;
  }

  /* ---- Partners ---- */

  .partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl) var(--space-2xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    Wordmarks stand in for the partner logos. Drop the real files into
    src/assets/partners/ and swap the <span> for an <Image>.
  */
  .partners__item {
    font-size: var(--step-2);
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.75;
    text-align: center;
  }

  .partners__item a {
    color: inherit;
    text-decoration: none;
  }

  .partners__item a:hover {
    opacity: 1;
    color: var(--olive);
  }

  @media (min-width: 48rem) {
    .services {
      gap: var(--space-2xl);
    }
  }
</style>
