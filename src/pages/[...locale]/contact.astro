---
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

import { site, guides, type Locale } from '../../data/site';
import { localeStaticPaths } from '../../lib/paths';
import { useTranslations, absoluteUrl, localePath, formatPrice } from '../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, trail } from '../../lib/schema';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const routeKey = 'contact';
const url = absoluteUrl(localePath(locale, routeKey));

const whatsappBase = `https://wa.me/${site.contact.whatsapp}`;
const price = formatPrice(site.pricing.privateDayRate, locale);

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: t('contact.title'),
    description: t('contact.blurb'),
    locale,
    type: 'ContactPage',
    updated: new Date(),
  }),
  breadcrumbNode(url, trail(locale, [{ name: t('nav.contact'), path: 'contact' }])),
]);
---

<Base
  title={`${t('nav.contact')} — ${site.name}`}
  description={t('contact.blurb')}
  locale={locale}
  routeKey={routeKey}
  jsonLd={jsonLd}
>
  <PageHeader eyebrow={t('nav.contact')} title={t('contact.title')} lede={t('contact.blurb')} />

  <div class="section">
    <div class="wrap contact">
      {/*
        No server, no form endpoint, no third party. The fields below assemble
        a message locally and hand it to WhatsApp or the visitor's mail client,
        which keeps the site static and means nothing is collected here at all.
      */}
      <section class="contact__composer" aria-labelledby="composer-heading">
        <h2 id="composer-heading">{t('form.heading')}</h2>
        <p class="contact__help">{t('form.help')}</p>

        <form class="composer" data-composer novalidate>
          <div class="composer__field">
            <label for="f-name">{t('form.name')}</label>
            <input id="f-name" name="name" type="text" autocomplete="name" />
          </div>

          <div class="composer__row">
            <div class="composer__field">
              <label for="f-dates">{t('form.dates')}</label>
              <input id="f-dates" name="dates" type="text" inputmode="text" />
            </div>

            <div class="composer__field composer__field--narrow">
              <label for="f-people">{t('form.people')}</label>
              <input id="f-people" name="people" type="number" min="1" max="30" inputmode="numeric" />
            </div>
          </div>

          <div class="composer__field">
            <label for="f-experience">{t('form.experience')}</label>
            <input
              id="f-experience"
              name="experience"
              type="text"
              placeholder={t('form.experiencePlaceholder')}
            />
          </div>

          <div class="composer__field">
            <label for="f-notes">{t('form.notes')}</label>
            <textarea id="f-notes" name="notes" rows="3"></textarea>
          </div>

          <div class="composer__actions">
            <a class="btn btn--whatsapp" data-wa href={whatsappBase} rel="noopener" target="_blank">
              {t('form.open')}
            </a>
            <a class="btn btn--ghost" data-mail href={`mailto:${site.contact.email}`}>
              {t('form.openMail')}
            </a>
          </div>
        </form>
      </section>

      <aside class="contact__direct">
        <h2>{t('contact.direct')}</h2>

        <ul class="contact__list">
          <li>
            <a href={`${whatsappBase}`} rel="noopener" target="_blank">
              <span class="contact__label">WhatsApp</span>
              <span class="contact__value">{site.contact.phoneDisplay}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`}>
              <span class="contact__label">Email</span>
              <span class="contact__value">{site.contact.email}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone}`}>
              <span class="contact__label">Telephone</span>
              <span class="contact__value">{site.contact.phoneDisplay}</span>
            </a>
          </li>
        </ul>

        <dl class="contact__meta">
          <div>
            <dt>{t('contact.based')}</dt>
            <dd>{site.address.locality}, {site.address.region}, {site.address.countryName}</dd>
          </div>
          <div>
            <dt>{t('label.languages')}</dt>
            <dd>{site.languagesSpoken.join(', ')}</dd>
          </div>
          <div>
            <dt>{t('facts.price')}</dt>
            <dd>{price} {t('label.perDay')}, {t('label.perGroup')}</dd>
          </div>
          <div>
            <dt>{t('nav.about')}</dt>
            <dd>{guides.map((g) => g.name).join(' & ')}</dd>
          </div>
        </dl>

        <p class="contact__response">{t('contact.response')}</p>
      </aside>
    </div>
  </div>
</Base>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .contact h2 {
    font-size: var(--step-2);
  }

  .contact__help {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    max-width: var(--measure);
    font-size: var(--step--1);
    line-height: var(--leading-relaxed);
  }

  .composer {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .composer__row {
    display: grid;
    gap: var(--space-s);
  }

  .composer__field {
    display: grid;
    gap: 0.35rem;
  }

  .composer__field label {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-700);
  }

  .composer input,
  .composer textarea {
    width: 100%;
    /* 16px minimum stops iOS Safari zooming the page on focus. */
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    color: var(--text);
    transition: border-color var(--duration) var(--ease-out);
  }

  .composer input:focus,
  .composer textarea:focus {
    border-color: var(--focus);
  }

  .composer textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .composer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .contact__direct {
    padding: var(--space-m);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
  }

  .contact__list {
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__list a {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-xs);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    text-decoration: none;
    color: inherit;
  }

  .contact__list a:hover {
    border-color: var(--border-strong);
  }

  .contact__label {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .contact__value {
    font-weight: 500;
    color: var(--link);
  }

  .contact__meta {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
  }

  .contact__meta dt {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .contact__meta dd {
    margin: 0.1rem 0 0;
    font-size: var(--step--1);
  }

  .contact__response {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  @media (min-width: 34rem) {
    .composer__row {
      grid-template-columns: 1fr 8rem;
    }
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 1.4fr) 20rem;
      gap: var(--space-2xl);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-composer]');
  const waLink = document.querySelector<HTMLAnchorElement>('[data-wa]');
  const mailLink = document.querySelector<HTMLAnchorElement>('[data-mail]');

  if (form && waLink && mailLink) {
    const waBase = waLink.href;
    const mailBase = mailLink.href;

    const build = () => {
      const data = new FormData(form);
      const get = (key: string) => String(data.get(key) ?? '').trim();

      const lines = ['Hi Blue Peaks!'];
      const name = get('name');
      const dates = get('dates');
      const people = get('people');
      const experience = get('experience');
      const notes = get('notes');

      if (name) lines.push(`My name is ${name}.`);
      if (dates) lines.push(`We are in Mallorca ${dates}.`);
      if (people) lines.push(`There are ${people} of us.`);
      if (experience) lines.push(`Walking we are used to: ${experience}.`);
      if (notes) lines.push(notes);
      lines.push("We'd like to ask about a guided hiking day.");

      const body = lines.join('\n');

      waLink.href = `${waBase}?text=${encodeURIComponent(body)}`;
      mailLink.href =
        `${mailBase}?subject=${encodeURIComponent('Hiking enquiry')}` +
        `&body=${encodeURIComponent(body)}`;
    };

    build();
    form.addEventListener('input', build);
    // Nothing is submitted anywhere; the two links are the only exits.
    form.addEventListener('submit', (event) => event.preventDefault());
  }
</script>
