---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import Faq from '../../components/Faq.astro';
import ContactCta from '../../components/ContactCta.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';

import { DEFAULT_LOCALE, type Locale } from '../../data/site';
import { getLocalisedEntry, getTranslatedLocales, localisedPaths } from '../../lib/content';
import { localePath, useTranslations, absoluteUrl, formatDate } from '../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, faqNode, trail } from '../../lib/schema';

/**
 * Standalone prose pages: /private-hikes/, /custom-hikes/, /about/, /legal/.
 *
 * They share this one template so that adding a page — or a translation of an
 * existing one — is a Markdown file and nothing else.
 */
export const getStaticPaths = (async () => localisedPaths('pages')) satisfies GetStaticPaths;

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);

const entry = await getLocalisedEntry('pages', locale, slug);
if (!entry) return Astro.rewrite('/404');

const { Content } = await render(entry);
const { data } = entry;

const availableLocales = await getTranslatedLocales('pages', slug);

const url = absoluteUrl(localePath(locale, slug));
const image = data.heroImage ? absoluteUrl(data.heroImage.src) : undefined;

const pageType =
  slug === 'about' ? 'AboutPage' : slug === 'contact' ? 'ContactPage' : 'WebPage';

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: data.title,
    description: data.description,
    locale,
    updated: data.updated,
    type: pageType,
    primaryImage: image,
  }),
  breadcrumbNode(url, trail(locale, [{ name: data.title, path: slug }])),
  faqNode(url, data.faqs),
]);
---

<Base
  title={data.metaTitle ?? data.title}
  description={data.description}
  locale={locale}
  routeKey={slug}
  availableLocales={availableLocales}
  isFallback={entry.isFallback}
  image={image}
  jsonLd={jsonLd}
  noindex={data.noindex}
  markdownUrl={locale === DEFAULT_LOCALE ? absoluteUrl(`/${slug}.md`) : undefined}
  flushHero
>
  <Hero
    eyebrow={data.eyebrow}
    title={data.heading ?? data.title}
    lede={data.lede}
    image={data.heroImage}
    imageAlt={data.heroAlt}
    seed={slug}
    size="compact"
  >
    {
      !data.hideCta && (
        <a class="btn btn--primary" href={localePath(locale, 'contact')}>
          {t('cta.enquire')}
        </a>
      )
    }
  </Hero>

  <div class="section">
    <div class="wrap wrap--prose page-body">
      {entry.isFallback && <TranslationNotice locale={locale} />}

      <AnswerBox>
        <p>{data.summary}</p>
      </AnswerBox>

      {
        data.points.length > 0 && (
          <ul class="points">
            {data.points.map((point) => (
              <li class="points__item">
                <h2 class="points__title">{point.title}</h2>
                <p class="points__body">{point.body}</p>
              </li>
            ))}
          </ul>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <Faq locale={locale} faqs={data.faqs} level={3} />

      <p class="page-body__updated">
        {t('label.updated')}: <time datetime={data.updated.toISOString()}>
          {formatDate(data.updated, locale)}
        </time>
      </p>
    </div>
  </div>

  {!data.hideCta && <ContactCta locale={locale} context={data.title} />}
</Base>

<style>
  .page-body > * + * {
    margin-top: var(--space-l);
  }

  .points {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points__item {
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
  }

  .points__title {
    font-size: var(--step-1);
    margin-bottom: var(--space-3xs);
  }

  .points__body {
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .page-body__updated {
    font-size: var(--step--1);
    color: var(--text-faint);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .points {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
