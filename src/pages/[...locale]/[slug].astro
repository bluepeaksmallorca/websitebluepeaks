---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import BokunWidget from '../../components/BokunWidget.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';

import { DEFAULT_LOCALE, type Locale } from '../../data/site';
import { getLocalisedEntry, getTranslatedLocales, localisedPaths } from '../../lib/content';
import { localePath, useTranslations, absoluteUrl, formatDate } from '../../i18n/utils';
import { buildGraph, webPageNode, breadcrumbNode, faqNode, trail } from '../../lib/schema';

/**
 * The service pages (/private-hikes/, /custom-hikes/, /hikes/) and the legal
 * notice. One template, one Markdown file per page per language.
 */
export const getStaticPaths = (async () => localisedPaths('pages')) satisfies GetStaticPaths;

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);

const entry = await getLocalisedEntry('pages', locale, slug);
if (!entry) return Astro.rewrite('/404');

const { Content } = await render(entry);
const { data } = entry;

const availableLocales = await getTranslatedLocales('pages', slug);
const url = absoluteUrl(localePath(locale, slug));

const jsonLd = buildGraph(locale, [
  webPageNode({
    url,
    title: data.title,
    description: data.description,
    locale,
    updated: data.updated,
  }),
  breadcrumbNode(url, trail(locale, [{ name: data.title, path: slug }])),
  faqNode(url, data.faqs),
]);
---

<Base
  title={data.metaTitle ?? data.title}
  description={data.description}
  locale={locale}
  routeKey={slug}
  availableLocales={availableLocales}
  isFallback={entry.isFallback}
  jsonLd={jsonLd}
  noindex={data.noindex}
  markdownUrl={locale === DEFAULT_LOCALE ? absoluteUrl(`/${slug}.md`) : undefined}
>
  <PageHeader eyebrow={data.eyebrow} title={data.title} lede={data.lede}>
    <Breadcrumbs slot="breadcrumbs" locale={locale} crumbs={[]} current={data.title} />
  </PageHeader>

  <div class="section section--tight">
    <div class="wrap page-body">
      {entry.isFallback && <TranslationNotice locale={locale} />}

      <div class="prose center-block">
        <Content />
      </div>

      {
        data.bokunProduct && (
          <div class="page-body__booking">
            <BokunWidget locale={locale} product={data.bokunProduct} context={data.title} />
          </div>
        )
      }

      <p class="page-body__updated">
        {t('label.updated')}:{' '}
        <time datetime={data.updated.toISOString()}>{formatDate(data.updated, locale)}</time>
      </p>
    </div>
  </div>

  {
    data.faqs.length > 0 && (
      <div class="section section--white">
        <div class="wrap">
          <Faq locale={locale} faqs={data.faqs} />
        </div>
      </div>
    )
  }
</Base>

<style>
  .page-body > * + * {
    margin-top: var(--space-xl);
  }

  .page-body__booking {
    max-width: 46rem;
    margin-inline: auto;
    /* Scroll target for the header CTA and any deep link into booking. */
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }

  .page-body__updated {
    max-width: var(--width-prose);
    margin-inline: auto;
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
</style>
