---
import { site, booking, type Locale } from '../data/site';
import { useTranslations } from '../i18n/utils';

/**
 * Bokun booking embed, with a WhatsApp fallback.
 *
 * Until the Bokun IDs are filled in (src/data/site.ts → `booking`), this
 * renders the enquiry card instead, so every page works today and switching a
 * page to real online booking is one config line.
 *
 * Two things to know before turning it on:
 *
 *  - Bokun's loader is third-party JavaScript. It is the only such script on
 *    the site, so `public/_headers` needs `widgets.bokun.io` added to
 *    `script-src`, `connect-src`, `frame-src` and `img-src`. The commented
 *    block in that file has the exact values.
 *  - It sets cookies. Once this is live the site is no longer cookie-free,
 *    and the privacy notice in src/content/pages/en/legal.md must say so.
 */
interface Props {
  locale: Locale;
  /** Which entry in `booking` this page uses. */
  product: 'privateHikes' | 'customHikes' | 'scheduledHikes';
  /** Prefills the WhatsApp message when falling back. */
  context: string;
}

const { locale, product, context } = Astro.props;
const t = useTranslations(locale);

const productId = booking[product];
const channel = booking.bookingChannelUUID;
const configured = Boolean(productId && channel);

const message = `Hi Blue Peaks! I'd like to ask about ${context}.`;
const whatsapp = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(message)}`;
const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(`Enquiry — ${context}`)}`;
---

{
  configured ? (
    <div class="bokun">
      <div
        class="bokunWidget"
        data-src={`https://widgets.bokun.io/online-sales/${channel}/experience/${productId}?partialView=1`}
      />
      <noscript>
        <p class="bokun__noscript">
          Online booking needs JavaScript. You can also{' '}
          <a href={whatsapp} rel="noopener" target="_blank">
            message us on WhatsApp
          </a>{' '}
          or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
        </p>
      </noscript>
    </div>
  ) : (
    <div class="enquire">
      <h2 class="enquire__title">{t('contact.title')}</h2>
      <p class="enquire__body">{t('contact.blurb')}</p>

      <div class="enquire__actions">
        <a class="btn btn--whatsapp" href={whatsapp} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.06s.89 2.39 1.01 2.56c.12.16 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z" />
          </svg>
          {t('cta.whatsapp')}
        </a>

        <a class="btn btn--outline" href={mailto}>
          {t('cta.email')}
        </a>
      </div>

      <p class="enquire__meta">{t('contact.response')}</p>
    </div>
  )
}

{
  configured && (
    <script
      is:inline
      async
      src={`https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=${channel}`}
    />
  )
}

<style>
  .bokun {
    min-height: 20rem;
  }

  .bokun__noscript {
    padding: var(--space-m);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
  }

  .enquire {
    padding: var(--space-l);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-s);
    text-align: center;
  }

  .enquire__title {
    font-size: var(--step-2);
  }

  .enquire__body {
    margin-top: var(--space-xs);
    max-width: 40ch;
    margin-inline: auto;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .enquire__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .enquire__meta {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  @media (max-width: 26rem) {
    .enquire__actions > .btn {
      width: 100%;
    }
  }
</style>
