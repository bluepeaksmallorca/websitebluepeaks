---
/**
 * Interior page header: centred title over the greige ground, with the olive
 * rule the rest of the site uses for section titles.
 *
 * Sits below the sticky header rather than behind it — only the homepage hero
 * runs under the transparent header.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Set in the serif, for blog posts. */
  serif?: boolean;
}
const { eyebrow, title, lede, serif = false } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <slot name="breadcrumbs" />

    <div class="page-header__inner">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class:list={['page-header__title', { 'page-header__title--serif': serif }]}>
        {title}
      </h1>
      <span class="page-header__rule" aria-hidden="true"></span>
      {lede && <p class="page-header__lede">{lede}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-block: calc(var(--space-2xl) + var(--space-s)) var(--space-xl);
  }

  .page-header__inner {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
  }

  .page-header .eyebrow {
    margin-bottom: var(--space-2xs);
  }

  .page-header__title {
    font-size: var(--step-5);
    font-weight: 600;
  }

  .page-header__title--serif {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--olive);
    letter-spacing: 0;
  }

  .page-header__rule {
    display: block;
    width: 6.5rem;
    height: 2px;
    margin: var(--space-m) auto 0;
    background: var(--rule);
  }

  .page-header__lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .page-header :global(.crumbs) {
    margin-bottom: var(--space-l);
  }
</style>
