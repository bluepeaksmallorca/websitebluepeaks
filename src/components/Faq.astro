---
import type { Locale } from '../data/site';
import { useTranslations } from '../i18n/utils';

/**
 * The FAQ accordion, matching the live site: a bordered stack of questions
 * with a plus that turns into a minus.
 *
 * Built on <details>/<summary>, so it works with no JavaScript, is keyboard
 * operable for free, and — the part that matters for the AI-findability goal —
 * keeps every answer in the DOM whether it is open or not. Collapsed content
 * is still indexed and still extractable; the same array is also emitted as
 * FAQPage JSON-LD by the page that renders this.
 */
interface Props {
  locale: Locale;
  faqs: Array<{ q: string; a: string }>;
  heading?: string;
  id?: string;
}

const { locale, faqs, heading, id = 'faqs' } = Astro.props;
const t = useTranslations(locale);
---

{
  faqs.length > 0 && (
    <section class="faq" id={id} aria-labelledby={`${id}-heading`}>
      <div class="section-title">
        <h2 class="section-title__text" id={`${id}-heading`}>
          {heading ?? t('label.faq')}
        </h2>
      </div>

      <div class="faq__list">
        {faqs.map((faq, index) => (
          <details class="faq__item" name={id} open={index === 0}>
            <summary class="faq__q">
              <span>{faq.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq__list {
    max-width: 52rem;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    overflow: hidden;
    background: var(--white);
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--border);
  }

  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    /* Generous padding: these are thumb targets, and the live site is roomy. */
    padding: var(--space-m) var(--space-m);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--navy);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration) var(--ease-out);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    background: rgb(0 0 0 / 0.02);
  }

  /* The plus, drawn from two bars so it can rotate into a minus. */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.28em;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2.5px;
    background: var(--navy);
    border-radius: 2px;
    transform: translateY(-50%);
    transition: transform var(--duration) var(--ease-out);
  }

  .faq__icon::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 var(--space-m) var(--space-m);
  }

  .faq__a p {
    max-width: var(--measure);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  @media (min-width: 48rem) {
    .faq__q {
      padding: var(--space-m) var(--space-l);
      font-size: var(--step-1);
    }

    .faq__a {
      padding: 0 var(--space-l) var(--space-l);
    }
  }
</style>
