---
import type { Locale } from '../data/site';
import { useTranslations } from '../i18n/utils';

/**
 * Questions and answers as plain headings and paragraphs — deliberately not an
 * accordion.
 *
 * Collapsed <details> content is still indexable, but an open, flat question →
 * answer pair is the most reliably extractable shape there is, and this is the
 * block most likely to be quoted back to someone asking an assistant about
 * hiking in Mallorca. The small cost in page length is worth it.
 *
 * The same array is rendered into FAQPage JSON-LD by the page that uses it.
 */
interface Props {
  locale: Locale;
  faqs: Array<{ q: string; a: string }>;
  /** Override the section heading. */
  heading?: string;
  /** Heading level for the questions, so the document outline stays sane. */
  level?: 2 | 3;
  id?: string;
}

const { locale, faqs, heading, level = 3, id = 'faq' } = Astro.props;
const t = useTranslations(locale);
const QTag = `h${level}` as 'h2' | 'h3';
const HeadingTag = `h${level - 1}` as 'h1' | 'h2';
---

{
  faqs.length > 0 && (
    <section class="faq" id={id} aria-labelledby={`${id}-heading`}>
      <HeadingTag class="faq__heading" id={`${id}-heading`}>
        {heading ?? t('label.faq')}
      </HeadingTag>

      <div class="faq__list">
        {faqs.map((faq) => (
          <div class="faq__item">
            <QTag class="faq__q">{faq.q}</QTag>
            <p class="faq__a">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq__heading {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }

  .faq__list {
    display: grid;
    gap: var(--space-m);
  }

  .faq__item {
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--border);
  }

  .faq__item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .faq__q {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: 0;
    color: var(--ink-800);
    margin-bottom: var(--space-3xs);
  }

  .faq__a {
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: var(--measure);
  }

  /* Two columns once there is room; questions stay with their answers. */
  @media (min-width: 60rem) {
    .faq__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-l) var(--space-xl);
    }
  }
</style>
