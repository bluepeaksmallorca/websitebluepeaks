---
import type { Locale } from '../data/site';
import { formatNumber, useTranslations } from '../i18n/utils';
import { formatMonthRanges } from '../lib/format';

/**
 * The route's hard numbers, as a definition list.
 *
 * Distance, ascent and walking time are the facts people actually search for,
 * and the facts an assistant needs in order to answer "is this hike hard?".
 * They appear here in readable text, in the Markdown mirror, and in the
 * TouristTrip `additionalProperty` markup — three formats, one set of values,
 * all coming from the same front matter.
 */
export interface RouteFacts {
  difficulty: 'easy' | 'moderate' | 'challenging' | 'demanding';
  distanceKm: number;
  ascentM: number;
  descentM?: number;
  durationHoursMin: number;
  durationHoursMax: number;
  summitM?: number;
  startPoint: string;
  endPoint?: string;
  circular: boolean;
  terrain: string;
  bestMonths: number[];
}

interface Props {
  locale: Locale;
  facts: RouteFacts;
  /** Renders without the surrounding card, for use inside a sidebar. */
  bare?: boolean;
}

const { locale, facts, bare = false } = Astro.props;
const t = useTranslations(locale);

const km = (v: number) => `${formatNumber(v, locale, { maximumFractionDigits: 1 })} km`;
const m = (v: number) => `${formatNumber(v, locale)} m`;

const duration =
  facts.durationHoursMin === facts.durationHoursMax
    ? `${formatNumber(facts.durationHoursMin, locale)} h`
    : `${formatNumber(facts.durationHoursMin, locale)}–${formatNumber(facts.durationHoursMax, locale)} h`;

const startEnd = facts.circular
  ? facts.startPoint
  : facts.endPoint
    ? `${facts.startPoint} → ${facts.endPoint}`
    : facts.startPoint;

const rows = [
  { label: t('facts.difficulty'), value: t(`diff.${facts.difficulty}`), badge: facts.difficulty },
  { label: t('facts.distance'), value: km(facts.distanceKm) },
  { label: t('facts.ascent'), value: m(facts.ascentM) },
  { label: t('facts.duration'), value: duration },
  ...(facts.summitM ? [{ label: 'Summit', value: m(facts.summitM) }] : []),
  { label: t('facts.start'), value: startEnd },
  { label: t('facts.terrain'), value: facts.terrain },
  ...(facts.bestMonths.length
    ? [{ label: t('facts.season'), value: formatMonthRanges(facts.bestMonths, locale) }]
    : []),
].filter(Boolean);
---

<dl class:list={['facts', { 'facts--bare': bare }]}>
  {
    rows.map((row) => (
      <div class="facts__row">
        <dt class="facts__label">{row.label}</dt>
        <dd class="facts__value">
          {row.badge ? (
            <span class:list={['badge', `badge--${row.badge}`]}>{row.value}</span>
          ) : (
            row.value
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    margin: 0;
    padding: var(--space-s) var(--space-m);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
  }

  .facts--bare {
    padding: 0;
    background: none;
    border: 0;
  }

  .facts__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
  }

  .facts__row:last-child {
    border-bottom: 0;
  }

  .facts__label {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    margin: 0;
  }

  .facts__value {
    margin: 0;
    font-weight: 500;
    text-align: right;
    /* Long start points ("Cúber reservoir car park") wrap instead of overflowing. */
    min-width: 0;
  }
</style>
