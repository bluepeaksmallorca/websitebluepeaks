---
import type { Locale } from '../data/site';
import { localePath, LOCALES } from '../i18n/utils';
import { localeNames } from '../i18n/ui';

interface Props {
  locale: Locale;
  routeKey: string;
  /** Locales that actually serve this route; others link to the home page. */
  availableLocales?: readonly Locale[];
  id?: string;
}

const { locale, routeKey, availableLocales = LOCALES, id = 'lang' } = Astro.props;

const options = LOCALES.map((code) => ({
  code,
  name: localeNames[code],
  // Sending someone to a 404 is worse than sending them to a translated home
  // page, so untranslated routes fall back to the root of that language.
  href: availableLocales.includes(code) ? localePath(code, routeKey) : localePath(code),
  current: code === locale,
}));
---

<details class="lang" id={id}>
  <summary class="lang__toggle" aria-label={`Language: ${localeNames[locale]}`}>
    <svg
      class="lang__globe"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
    </svg>
    <span class="lang__code">{locale.toUpperCase()}</span>
    <svg
      class="lang__chevron"
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>

  <ul class="lang__list">
    {
      options.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            class:list={['lang__item', { 'is-current': option.current }]}
            aria-current={option.current ? 'true' : undefined}
          >
            {option.name}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }

  .lang__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color var(--duration) var(--ease-out);
  }

  .lang__toggle::-webkit-details-marker {
    display: none;
  }

  .lang__toggle:hover {
    background: var(--bg-sunken);
    color: var(--text);
  }

  .lang__chevron {
    transition: transform var(--duration) var(--ease-out);
  }

  .lang[open] .lang__chevron {
    transform: rotate(180deg);
  }

  .lang__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 60;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-l);
  }

  .lang__item {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-s);
    font-size: var(--step--1);
    color: var(--text);
    text-decoration: none;
  }

  .lang__item:hover {
    background: var(--bg-subtle);
  }

  .lang__item.is-current {
    font-weight: 600;
    color: var(--primary);
  }

  /*
    Inside the mobile menu the dropdown has nowhere to overlay, so it becomes a
    plain inline row of languages instead.
  */
  :global(.nav-panel) .lang {
    width: 100%;
  }

  :global(.nav-panel) .lang__toggle {
    width: 100%;
    justify-content: space-between;
    border: 1px solid var(--border);
  }

  :global(.nav-panel) .lang__list {
    position: static;
    box-shadow: none;
    margin-top: 0.35rem;
  }
</style>
