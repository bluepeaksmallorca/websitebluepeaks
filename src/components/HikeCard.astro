---
import { Image } from 'astro:assets';
import type { Locale } from '../data/site';
import { localePath, useTranslations, formatNumber } from '../i18n/utils';
import Placeholder from './Placeholder.astro';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  facts: {
    difficulty: 'easy' | 'moderate' | 'challenging' | 'demanding';
    distanceKm: number;
    ascentM: number;
    durationHoursMin: number;
    durationHoursMax: number;
  };
  /** Card position in the grid; the first few load eagerly. */
  index?: number;
}

const { locale, slug, title, summary, image, imageAlt = '', facts, index = 99 } = Astro.props;
const t = useTranslations(locale);

const duration =
  facts.durationHoursMin === facts.durationHoursMax
    ? `${formatNumber(facts.durationHoursMin, locale)} h`
    : `${formatNumber(facts.durationHoursMin, locale)}–${formatNumber(facts.durationHoursMax, locale)} h`;
---

<article class="card hike-card">
  <div class="card__media">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
          loading={index < 3 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <Placeholder seed={slug} label={title} />
      )
    }

    <span class:list={['badge', `badge--${facts.difficulty}`, 'hike-card__difficulty']}>
      {t(`diff.${facts.difficulty}`)}
    </span>
  </div>

  <div class="card__body">
    <h3 class="card__title">
      <a href={localePath(locale, `hikes/${slug}`)}>{title}</a>
    </h3>

    <p class="hike-card__summary">{summary}</p>

    <ul class="card__meta">
      <li>{formatNumber(facts.distanceKm, locale, { maximumFractionDigits: 1 })} km</li>
      <li>{formatNumber(facts.ascentM, locale)} m {t('facts.ascent').toLowerCase()}</li>
      <li>{duration}</li>
    </ul>
  </div>
</article>

<style>
  .hike-card .card__media {
    position: relative;
  }

  .hike-card__difficulty {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    /* Sits over photography, so it needs its own opaque ground. */
    box-shadow: var(--shadow-s);
  }

  .hike-card__summary {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    /* Keeps every card in a row the same height without a fixed height. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hike-card .card__meta {
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: var(--space-xs) 0 0;
    border-top: 1px solid var(--border);
  }

  .hike-card .card__meta li {
    position: relative;
  }

  .hike-card .card__meta li + li::before {
    content: '';
    position: absolute;
    left: calc(var(--space-s) / -2);
    top: 50%;
    width: 3px;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 50%;
    background: var(--stone-400);
  }
</style>
