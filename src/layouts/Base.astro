---
import '../styles/global.css';

import type { Locale } from '../data/site';
import { LOCALES } from '../i18n/utils';
import { localeTags } from '../i18n/ui';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: string;
  availableLocales?: readonly Locale[];
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: string;
  noindex?: boolean;
  markdownUrl?: string;
  /** True when this locale has no translation and English is being shown. */
  isFallback?: boolean;
  /** Homepage only: the header floats transparently over the video hero. */
  overHero?: boolean;
}

const {
  locale,
  routeKey,
  availableLocales = LOCALES,
  overHero = false,
  ...head
} = Astro.props;
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <BaseHead
      locale={locale}
      routeKey={routeKey}
      availableLocales={availableLocales}
      {...head}
    />
  </head>

  <body>
    <Header locale={locale} routeKey={routeKey} overHero={overHero} />

    <main id="main" class:list={[{ 'main--over': overHero }]}>
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>

<style>
  main {
    display: block;
  }

  /*
    The video hero runs up behind the sticky header; every other page starts
    below it.
  */
  .main--over {
    margin-top: calc(var(--header-h) * -1);
  }
</style>
